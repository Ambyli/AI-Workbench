# Set to true to write DEBUG-level logs to the log file (default: INFO and above only).
DEBUG_LOGGING=false

# Comma-separated path prefixes to include. Only sessions whose working
# directory starts with one of these will be counted. Leave blank to include all.
# Example: C:\Users\<you>\OneDrive\Documents\Zoe
INCLUDE_PATHS=

# Days of the week to exclude from limit calculations (0=Monday, 6=Sunday).
# These days are still displayed in totals but ignored when computing averages.
EXCLUDE_WEEKDAYS=5,6

# ── Console stats (requires: pip install selenium) ────────────────────────────
# Set to true to enable scraping console.anthropic.com for account-level usage.
# When false (default), the Console section is hidden from the widget entirely.
CONSOLE_FETCHER_ENABLED=false

# How often to re-scrape console.anthropic.com for account-level usage (minutes).
CONSOLE_REFRESH_MINUTES=30

# Set to false to always show the Chrome window (useful for debugging scrape issues).
CONSOLE_HEADLESS=true

# Alternative Chrome path as a last resort (used in CHROME_PATHS list).
# Leave empty to use the default paths.
# Example: C:\Program Files\Google\Chrome Stable\Application\chrome.exe
CHROME_PATHS_VAR=

# ── Local LLM server ──────────────────────────────────────────────────────────
# Maximum number of lines kept in the LLM Backend server log (oldest removed first).
LLM_LOG_MAX_LINES=200

# Base URL for the local LLM (used by Claude Code's ANTHROPIC_BASE_URL override).
# Change this if your server runs on a different machine or port.
LLM_URL=http://localhost:8001
LLM_API_KEY=sk-your-key-here
LLM_MODEL=your-model-alias

# Full command to launch llama-server. Change path and flags as required.
LLAMA_SERVER_CMD=

# Port for Chrome remote debugging (used by CDP account stats).
BROWSER_DEBUG_PORT=9222

# Keep the local LLM server alive when switching away from it (true/false).
KEEP_LLM_ACTIVE=true

# ── PORT REGISTRY — update here first, then nowhere else ─────────────────────
# Next free port: 8013
#
# Postgres ports are grouped: 5432 (litellm_db), 5433 (roofix-db), 5434 (sandbox-db), 5435 (n8n-db).
#
# Host port         Internal  Service             Compose file
# ──────────────────────────────────────────────────────────────────────────────
PORT_LITELLM=4001           # 4000     litellm             litellm.yml
PORT_POSTGRES=5432          # 5432     litellm_db          litellm.yml
PORT_ROOFIX_DB=5433         # 5432     roofix-db           roofix.yml
PORT_SANDBOX_DB=5434        # 5432     sandbox-db          sandbox.yml
PORT_N8N_DB=5435            # 5432     n8n-db              n8n.yml
PORT_PROMETHEUS=9090        # 9090     prometheus          litellm.yml
PORT_VLLM_QWEN36=8002       # 8000     qwen3.6             vllm.yml
PORT_VLLM_QWEN38=8003       # 8000     qwen3.8             vllm.yml
PORT_VLLM_QWEN_VL=8006      # 8000     vllm-qwen-vl        vllm.yml
PORT_KOKORO_API=8004        # 8000     kokoro-api          kokoro.yml
PORT_CLASSIFIER=8005        # 8000     classifier          classifier.yml
PORT_OPENWEBUI=8007         # 8080     openwebui           openwebui.yml
PORT_MADLAD_API=8008        # 8000     madlad-api          madlad.yml
PORT_UNSLOTH_MODEL=8000     # 8000     unsloth (model)     unsloth.yml
PORT_UNSLOTH_JUPYTER=8888   # 8888     unsloth (jupyter)   unsloth.yml
PORT_UNSLOTH_SSH=2222       # 22       unsloth (ssh)       unsloth.yml
PORT_OAUTH2_PROXY=4180      # 4180     oauth2-proxy        oauth2-proxy.yml
PORT_SEARXNG=8009           # 8080     searxng             searxng.yml
PORT_LLAMA_GLM52=8010       # 8000     glm5.2              llama.yml
PORT_SANDBOX_PROXY=8011     # 80       sandbox-proxy       sandbox.yml
PORT_SANDBOX_RUNNER=8012    # 8000     sandbox-runner      sandbox.yml

# ── vLLM config ──────────────────────────────────────────────────────────────
# HuggingFace token — shared by both vLLM (gated/registered model downloads)
# and Open WebUI (gated embedding / RAG model downloads).
# Get one at https://huggingface.co/settings/tokens
# (Model, port, and other settings are defined in docker-compose.vllm.yml)
HF_TOKEN=

# ── LiteLLM config ──────────────────────────────────────────────────────────────
DEFAULT_LITELLM_MASTER_KEY=sk-your-master-key
DEFAULT_LITELLM_MODEL_NAME=qwen3.6-unsloth
DEFAULT_LITELLM_MODEL=openai/your-model
DEFAULT_LITELLM_MODEL_API_KEY=sk-your-api-key
DEFAULT_LITELLM_MODEL_API_BASE=http://unsloth:8000/v1 # must include /v1 for compatibility with OpenAI endpoints
DEFAULT_LITELLM_DATABASE_URL=postgresql://llmproxy:dbpassword9090@db:5432/litellm # example for Docker Compose; adjust as needed for your database setup
DEFAULT_LITELLM_MCP_PHOENIX_URL=https://phoenix-mcp.com/mcp
DEFAULT_LITELLM_MCP_PHOENIX_AUTH_VALUE=

# Anthropic API key — used by the `claude-sonnet-5` context-window fallback model.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Open WebUI config ─────────────────────────────────────────────────────────
# Persistent session secret. Without a stable value, every container recreate
# logs out all users. Rotate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=change-me-run-openssl-rand-hex-32

# Allowed CORS origin for API calls into Open WebUI. Must match the origin
# users actually load the UI from (scheme + host + port, no trailing slash).
# Comma-separate multiple values. Use "*" only for local-only / dev use.
CORS_ALLOW_ORIGIN=

# OpenAI-compatible endpoint Open WebUI calls for chat completions. In this
# stack it is the LiteLLM proxy on the ai_shared Docker network — must be the
# service DNS name (litellm:4000), NOT localhost, when running in compose.
OPENWEBUI_OPENAI_API_BASE_URL=http://litellm:4000/v1

# API key Open WebUI sends to the endpoint above. Use a LiteLLM virtual key
# scoped to the specific chat models Open WebUI should see (create one in the
# LiteLLM Admin UI → Virtual Keys, or via the /key/generate API). Avoid using
# DEFAULT_LITELLM_MASTER_KEY here — that key sees every model including TTS
# (kokoro) and would expose unrelated entries in the chat model picker.
OPENWEBUI_OPENAI_API_KEY=

# Disable Ollama discovery probe — every model in this stack is served via
# LiteLLM. Flip to "true" only if you also stand up an Ollama container.
OPENWEBUI_ENABLE_OLLAMA_API=false

# Allow new account sign-ups. "false" locks the deployment after the first
# user; "true" lets anyone with the URL create an account.
OPENWEBUI_ENABLE_SIGNUP=true

# Role assigned to new signups. "pending" routes them to an admin approval
# queue (Admin Panel → Users) before they can chat. Other values: "user",
# "admin". Note: the very first account ever created always becomes admin
# regardless of this setting.
OPENWEBUI_DEFAULT_USER_ROLE=pending

# Public base URL Open WebUI is reachable at. Used to build OAuth callback
# URLs. Set to the address users actually type into the browser — e.g.
# http://localhost:8007 for local-only use, or https://chat.example.com
# when fronted by Cloudflare Tunnel.
OPENWEBUI_WEBUI_URL=

# ── Open WebUI: Google OAuth ─────────────────────────────────────────────────
# Master switch for OAuth sign-up flows.
OPENWEBUI_ENABLE_OAUTH_SIGNUP=true

# When true, an OAuth login matching an existing local account's email is
# merged into that local account instead of creating a duplicate.
OPENWEBUI_OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true

# Google Cloud OAuth 2.0 client credentials.
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${OPENWEBUI_WEBUI_URL}/oauth/google/callback
OPENWEBUI_GOOGLE_CLIENT_ID=
OPENWEBUI_GOOGLE_CLIENT_SECRET=

# OIDC discovery document for the OAuth provider. Required for logout to
# properly terminate the provider-side session — without it Open WebUI logs
# a warning and the logout flow only clears the local cookie.
# For Google: https://accounts.google.com/.well-known/openid-configuration
OPENWEBUI_OPENID_PROVIDER_URL=https://accounts.google.com/.well-known/openid-configuration

# ── Open WebUI: Trusted-header SSO (single sign-on via oauth2-proxy) ─────────
# When set, Open WebUI trusts these HTTP headers as the authenticated user's
# identity — first hit creates an account, subsequent hits sign in silently.
# oauth2-proxy populates them because OAUTH2_PROXY_PASS_USER_HEADERS=true
# above. Together they eliminate the second (Open-WebUI-side) Google login
# after the operator has already signed in at oauth2-proxy.
#
# SECURITY: Only enable these when Open WebUI is reachable EXCLUSIVELY via
# oauth2-proxy. Anyone who can hit openwebui:8080 directly can spoof
# X-Forwarded-Email and log in as any account. If you left the openwebui
# host publish (PORT_OPENWEBUI=8007) on 0.0.0.0, either restrict the bind
# to 127.0.0.1 in ai/openwebui/docker-compose.openwebui.yml or drop the
# publish entirely. See ai/openwebui/OPENWEBUI.md § Trusted-header SSO.
#
# Blank both values to fall back to the old flow (Google OAuth inside
# Open WebUI itself, requiring a second login).
OPENWEBUI_WEBUI_AUTH_TRUSTED_EMAIL_HEADER=X-Forwarded-Email
OPENWEBUI_WEBUI_AUTH_TRUSTED_NAME_HEADER=X-Forwarded-User

# URL the Open WebUI "Log out" button redirects to after clearing its
# own session. Point at oauth2-proxy's /oauth2/sign_out endpoint so the
# oauth2-proxy cookie is also cleared — otherwise trusted-header auth
# silently re-logs the user in on the very next page load (the still-
# valid oauth2-proxy cookie makes X-Forwarded-Email reappear, and Open
# WebUI creates a fresh session from it).
#
# ?rd=/ tells oauth2-proxy where to send the browser after clearing the
# cookie. Must be a same-origin path (OAUTH2_PROXY_WHITELIST_DOMAINS
# gates cross-origin redirects). Landing on / then triggers the normal
# Google sign-in flow again.
#
# This does NOT sign the user out of Google itself — a Workspace user
# with an active Google session will Google-SSO back in without a
# password prompt when they click "sign in". Kicking them out of Google
# entirely would also log them out of Gmail / Docs which is too invasive.
OPENWEBUI_WEBUI_AUTH_SIGNOUT_REDIRECT_URL=/oauth2/sign_out?rd=/

# User-Agent string Open WebUI uses for outbound HTTP requests from its RAG /
# web loaders (langchain_community). Identifies your deployment to remote
# sites; silences the "USER_AGENT environment variable not set" warning.
OPENWEBUI_USER_AGENT=OpenWebUI/1.0 (+https://github.com/open-webui/open-webui)

# Seconds Open WebUI waits for an MCP server to respond to the initialize
# handshake before giving up. Raise this if Phoenix or another remote MCP
# server cold-starts slowly (default upstream: 10).
OPENWEBUI_MCP_INITIALIZE_TIMEOUT=30

# ── SearXNG config ───────────────────────────────────────────────────────────
# Self-hosted metasearch backing Open WebUI's web-search feature. The service
# lives on ai_shared as `searxng:8080`; the host publish (PORT_SEARXNG) is only
# for direct sanity-checks. See ai/searxng/SEARXNG.md.
#
# Secret used to sign SearXNG sessions. Generate with `openssl rand -hex 32`
# (or the PowerShell recipe below the OAUTH2_PROXY_COOKIE_SECRET block). If
# blank, SearXNG boots with the placeholder from ai/searxng/settings.yml —
# fine for a first boot, rotate before real use.
SEARXNG_SECRET=

# Open WebUI web-search wiring. These are only read on the first boot of a
# fresh openwebui_data volume — on an existing install, set them via
# Admin Panel → Settings → Web Search instead. See ai/searxng/SEARXNG.md.
OPENWEBUI_ENABLE_WEB_SEARCH=true
OPENWEBUI_WEB_SEARCH_ENGINE=searxng
OPENWEBUI_SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>&format=json
OPENWEBUI_WEB_SEARCH_RESULT_COUNT=3
OPENWEBUI_WEB_SEARCH_CONCURRENT_REQUESTS=10

# ── oauth2-proxy: Google group gating in front of Open WebUI ─────────────────
# 32-byte URL-safe base64 cookie signing secret. Generate with (PowerShell):
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b) -replace '\+','-' -replace '/','_'
# Or on any POSIX shell:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# OAuth provider. Only google is exercised in this stack.
OAUTH2_PROXY_PROVIDER=google

# Listen address inside the container. Port must match PORT_OAUTH2_PROXY in
# the PORT REGISTRY above; the interface should stay 0.0.0.0 so it is
# reachable from cloudflared on the ai_shared network.
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180

# Trust X-Forwarded-* headers from cloudflared so cookies and redirect logic
# see the real client-facing scheme/host, not the tunnel's internal hop.
OAUTH2_PROXY_REVERSE_PROXY=true

# Forward the authenticated identity to Open WebUI as X-Forwarded-Email /
# X-Forwarded-User (also X-Auth-Request-*). Open WebUI consumes these via
# WEBUI_AUTH_TRUSTED_EMAIL_HEADER / WEBUI_AUTH_TRUSTED_NAME_HEADER (set
# further down) so a Google sign-in at oauth2-proxy also signs the user
# into Open WebUI — no second login prompt.
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true

# Path INSIDE the container to the service-account JSON. The host-side file
# is bind-mounted from ai/oauth2-proxy/sa-key.json in the compose file — do
# not change this path unless you also change the mount.
OAUTH2_PROXY_GOOGLE_SERVICE_ACCOUNT_JSON=/etc/oauth2-proxy/sa-key.json

# Path INSIDE the container to the branded sign_in.html / error.html templates.
# Host-side files live in ai/oauth2-proxy/templates/ and are bind-mounted by
# the compose file. See ai/oauth2-proxy/OAUTH2_PROXY.md § Branded sign-in and error pages.
OAUTH2_PROXY_CUSTOM_TEMPLATES_DIR=/etc/oauth2-proxy/templates

# Session lifetime and refresh cadence. Cookie is revalidated against Google
# every OAUTH2_PROXY_COOKIE_REFRESH; group-membership revocations propagate on
# the next refresh. Hard-expires at OAUTH2_PROXY_COOKIE_EXPIRE.
OAUTH2_PROXY_COOKIE_EXPIRE=1h
OAUTH2_PROXY_COOKIE_REFRESH=15m

# SameSite policy on the session cookie. `none` lets the cookie flow in
# cross-site subresource requests — needed because the sandbox iframe
# rendered inside OpenWebUI's tool-result frame is loaded from an
# opaque/null-origin context, and the default `lax` policy would
# suppress the cookie there, causing the iframe to be redirected to
# the sign-in page. Requires the cookie to also be Secure (default:
# true when OAUTH2_PROXY_REDIRECT_URL is https). The cookie remains
# HttpOnly, so JS on any other site still cannot read it. Set to
# `lax` (or blank) if you don't need iframe embedding.
OAUTH2_PROXY_COOKIE_SAMESITE=none

# Public hostname the browser hits — cookie is scoped to this domain, and
# oauth2-proxy will only redirect back here after Google login. Must match the
# Authorized redirect URI registered on the Google OAuth 2.0 client, minus
# the /oauth2/callback path.
OAUTH2_PROXY_COOKIE_DOMAINS=
OAUTH2_PROXY_WHITELIST_DOMAINS=
OAUTH2_PROXY_REDIRECT_URL=

# Where oauth2-proxy forwards authenticated requests. Docker service DNS on
# the ai_shared network — NOT localhost. Multi-upstream with longest-prefix
# match: /assets/* is routed to the oauth2-assets sidecar (see § Branded
# sign-in and error pages in ai/oauth2-proxy/OAUTH2_PROXY.md), everything else to openwebui.
OAUTH2_PROXY_UPSTREAMS=http://openwebui:8080,http://oauth2-assets:80/assets/,http://sandbox-proxy:80/sandboxes/

# Regex(es) of paths oauth2-proxy serves WITHOUT auth. Needed so the sign-in
# and error pages can <img src="/assets/..."> the Zeo logo before login.
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/assets/

# Access gate — only accounts in this Workspace domain AND this group can
# reach Open WebUI. Managed from Google Admin → Directory → Groups.
OAUTH2_PROXY_EMAIL_DOMAINS=
OAUTH2_PROXY_GOOGLE_GROUPS=

# Workspace admin the service account impersonates when calling the Google
# Directory API for group lookups. Must be a real Workspace admin on the same
# tenant as the group above.
OAUTH2_PROXY_GOOGLE_ADMIN_EMAIL=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from a Cloudflare Zero Trust tunnel that maps a public hostname (e.g.
# chat.example.com) to a local origin service (e.g. http://localhost:8007).
# Create at: https://one.dash.cloudflare.com → Networks → Tunnels → Create.
# Consumed by `make tunnel` (see Makefile).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Kokoro TTS config ─────────────────────────────────────────────────────────
# URL of the kokoro-app inference container. In Docker Compose this resolves via
# the service name. For local development point it at localhost.
KOKORO_APP_URL=http://kokoro-app:8085

# Base URL returned by the text_to_speech MCP tool. Used to build the audio
# playback link. Override if the server runs on a different host or port.
AUDIO_BASE_URL=http://localhost:8004 # port must match PORT_KOKORO_API

# ── MADLAD-400 translation config ────────────────────────────────────────────
# URL of the madlad-app inference container. In Docker Compose this resolves via
# the service name. For local development point it at localhost.
MADLAD_APP_URL=http://madlad-app:8085

# HuggingFace repo ID for a PRE-CONVERTED CTranslate2 MADLAD checkpoint. Loaded
# directly by ctranslate2 — no conversion step, no torch/transformers dependency.
# Alternatives: SoybeanMilk/madlad400-10b-mt-ct2-int8_float16 (higher quality,
# larger VRAM), Nextcloud-AI/madlad400-3b-mt-ct2-int8 (CPU-friendly).
MADLAD_MODEL=SoybeanMilk/madlad400-3b-mt-ct2-int8_float16

# Unit test classifier config — used by unit-tests/classifier/test_classifier.py.
CLASSIFIER_BASE_URL=http://localhost:4001
CLASSIFIER_API_KEY=sk-your-master-key

# ── Roofix Bridge ─────────────────────────────────────────────────────────────
# Container is internal-only (no PORT_ entry). See ai/roofix/ROOFIX.md.
#
# NOTE: earlier this file referenced GMAIL_MCP_* / PHOENIX_MCP_* variables.
# Those were removed when we reverted from MCP to direct Gmail API + psycopg2.
# See ai/roofix/ROOFIX.md § "Gmail OAuth setup" and the config table for details.

# When true, the bridge decides + logs but never writes to Phoenix. Keep true
# until the Phoenix agent user is provisioned and field_mapping.json is filled.
DRY_RUN=true

# Agent phase. "0" = chatter + milestones only. "1" (future) = create + notify.
AGENT_PHASE=0

# Scheduler cadence for the bridge's internal APScheduler tick.
TICK_INTERVAL_SECONDS=300

# LiteLLM model alias the bridge uses when rules escalate to the AI fallback.
# Swap the LiteLLM config, not this value, to move Claude -> vLLM etc.
BRAIN_MODEL=qwen3.6-unsloth

# Max tokens per AI decision. Default 400. Increase for complex decisions.
BRAIN_MAX_TOKENS=400

# LiteLLM endpoint the bridge connects to for AI fallback decisions.
# In Docker Compose this is the service DNS name (litellm:4000).
# For local dev, point at your local LiteLLM instance.
ROOFIX_LLM_URL=http://litellm:4000
ROOFIX_LLM_API_KEY=sk-your-key-here

# Roofix notification-email sender. NOTE: two "o"s.
ROOFIX_SENDER=no-reply@roofix.io

# Gmail label the bridge stamps on every message it has evaluated. The
# default LISTENER_QUERY excludes it server-side (`-label:roofix/processed`)
# so already-processed emails don't fill the 25-message fetch window on
# subsequent ticks. Slash-separated names show as nested folders in the
# Gmail sidebar. Change here to move where operators see it in Gmail.
ROOFIX_PROCESSED_LABEL=roofix/processed

# Gmail search query the bridge polls. Empty = default:
#   is:unread from:${ROOFIX_SENDER} -label:${ROOFIX_PROCESSED_LABEL}
# Narrow for first live tests, e.g. to a single project — but keep the
# -label: clause or the fetch will re-pull every processed email each tick.
#   LISTENER_QUERY=is:unread from:no-reply@roofix.io "1521 Farley" -label:roofix/processed
LISTENER_QUERY=

# Comma-separated list of email addresses that receive forwarded escalations.
# Escalate decisions are forwarded here (subject prefixed "[Roofix Escalation]",
# body carries the escalation reason + the original email inline). Empty
# disables forwarding — escalates then stay unread in Gmail for direct operator
# review. Successful forward -> mark_read; failed forward or empty list ->
# leave unread. In both cases processed_store is marked ok so escalates aren't
# re-processed on subsequent ticks.
#   ESCALATION_RECIPIENTS=alice@example.com,bob@example.com
ESCALATION_RECIPIENTS=

# ── Gmail OAuth (direct Google API, no MCP) ─────────────────────────────────
# credentials.json = OAuth 2.0 client secrets you download from GCP
# (APIs & Services → Credentials → Create → OAuth client ID → Desktop app).
# token.json is written by the first successful interactive login.
#
# For LOCAL `uv run` on your Windows box, point these at real paths on disk.
# For Docker, leave as /config/... and set ROOFIX_BRIDGE_CONFIG_DIR to a host
# directory containing both files (bind-mounted into the container).
GMAIL_CREDENTIALS_PATH=/config/credentials.json
GMAIL_TOKEN_PATH=/config/token.json

# Host directory containing credentials.json + token.json for Docker deploys.
# Bind-mounted into the bridge container at /config (read-only).
ROOFIX_BRIDGE_CONFIG_DIR=./roofix/config

# ── ProcessedStore Postgres (compose-managed roofix-db service) ─────────────
# Backs the bridge's dedup / audit store. `docker compose -f
# ai/roofix/docker-compose.roofix.yml up -d` brings up a `roofix-db` postgres:16
# container that exposes PORT_ROOFIX_DB (from the PORT REGISTRY block above)
# on the host for remote querying (psql / DBeaver / DataGrip). See ROOFIX.md
# § "Connecting to the processed-store DB".
#
# ROOFIX_DB_PASSWORD defaults to "roofix" (the dev password baked into
# compose + app.py) — override here if you want something else. This DB
# only lives on the ai_shared docker network; if you ever expose it beyond
# the host, change the password to something real and don't commit it.
#
# To change the host port, edit PORT_ROOFIX_DB in the PORT REGISTRY at the
# top of this file — not here.
ROOFIX_DB_USER=roofix
ROOFIX_DB_PASSWORD=roofix
ROOFIX_DB_NAME=roofix

# ── Phoenix DB (direct psycopg2, no MCP) ────────────────────────────────────
# Fill these in with the real Phoenix Postgres credentials before turning
# DRY_RUN=false. Bridge will error at connect() if any of the required ones
# (HOST, NAME, USER, PASSWORD) are missing.
PHOENIX_DB_HOST=
PHOENIX_DB_PORT=5432
PHOENIX_DB_NAME=
PHOENIX_DB_USER=
PHOENIX_DB_PASSWORD=
PHOENIX_DB_SSLMODE=require

# Dedicated Phoenix user id the bridge writes as. Provision manually in Phoenix
# (create a "Roofix Bridge Agent" user, copy its id here). Writes are blocked
# until this is set — the client returns Result(ok=False) with a hint.
PHOENIX_AGENT_USER_ID=

# Column on `project` where Roofix ids are stamped (TEXT column preferred).
PHOENIX_ROOFIX_ID_COLUMN=migration_external_id

# ── interceptor ─────────────────────────────────────────────────────────────
# URL the roofix bridge posts /capture to. Docker Compose default is the
# container name (http://interceptor:8080). Running locally with
# `uv run uvicorn app:app --port 8080` inside ai/interceptor/ — point at
# localhost instead.
INTERCEPTOR_URL=http://interceptor:8080

# Named profile inside interceptor holding Roofix session cookies. Refresh
# via `curl -F archive=@roofix.tgz http://<host>:8080/profiles/roofix/refresh`.
ROOFIX_PROFILE_NAME=roofix

# Max concurrent /capture calls interceptor will run. Each slot is one
# Chrome instance (~200-400 MB RAM) plus, on same-profile collision, one
# profile-dir clone (~20-80 MB ephemeral disk under PROFILES_ROOT/.temp/).
# Setting this higher effectively multiplies the container's RAM + disk
# footprint at full saturation — size the container's memory limit and
# volume accordingly. Pool exhausted → HTTP 429.
INTERCEPTOR_MAX_CONCURRENT=8

# Root under which --user-data-dir profiles live. Default is the
# Docker volume mount at /data/profiles. Running locally on the host, that
# path isn't writable without root, override to a writable dir, e.g.
# INTERCEPTOR_PROFILES_ROOT=/path/to/AI-Workbench/data/profiles
INTERCEPTOR_PROFILES_ROOT=/data/profiles

# ── Sandbox subsystem ────────────────────────────────────────────────────────
# Runs untrusted, model-generated app code (Python / Node / static) in
# short-lived isolated containers, exposed via sandbox-proxy as iframe URLs
# for OpenWebUI's artifact panel. See ai/sandbox/SANDBOX.md for the full operator
# guide and the security-invariant checklist.
#
# Max simultaneous sandboxes. Each active sandbox is ~256-512 MB RAM +
# 1 CPU + the base-image disk footprint. Pool exhausted → HTTP 429.
SANDBOX_MAX_CONCURRENT=8

# Default idle lifetime (seconds). A sandbox with no HTTP traffic for this
# long is torn down by the reaper. Model can request a shorter TTL per /run;
# it cannot request a longer one than SANDBOX_HARD_TTL_SECONDS.
SANDBOX_DEFAULT_TTL_SECONDS=900

# Absolute cap on sandbox lifetime. Even a busy sandbox is torn down at
# this point — prevents a stuck app from holding a slot indefinitely.
SANDBOX_HARD_TTL_SECONDS=3600

# Egress destination allowlist. Additive to the domains hard-coded in
# ai/sandbox/proxies/tinyproxy.filter — use this only when you need a per-deployment
# tweak. Comma-separated hostnames, no protocol. Empty = filter file only.
# The filter file is the primary source of truth; edit there when possible.
SANDBOX_EGRESS_ALLOWLIST=

# Public URL where iframes served by sandbox-proxy are reachable from a
# user's browser. The runner returns this + /{sandbox_id}/ as the iframe
# src in POST /run, /tool/preview_app, and the preview_app MCP tool.
#
# The default (http://sandbox-proxy) is a Docker service name — works
# only when the browser is on the container host itself. For any user
# hitting the deployment via cloudflared, override this to a public URL.
#
# Recommended pattern (see ai/sandbox/SANDBOX.md § Public iframe routing):
# route the sandbox under the same origin as Open WebUI via oauth2-proxy,
# then set this to https://<your-openwebui-host>/sandboxes. That reuses
# the auth cookie (no separate sign-in), keeps the browser same-origin
# (no CSP surprise), and requires only two changes:
#   1. Add sandbox-proxy to OAUTH2_PROXY_UPSTREAMS above under the same
#      /sandboxes/ path prefix.
#   2. Set this variable to the public URL.
# The /sandboxes/{id}/ route in ai/sandbox/proxies/Caddyfile already matches the
# rewritten path.
SANDBOX_PROXY_URL=http://sandbox-proxy

# ── sandbox-db (compose-managed Postgres backing PostgresRegistry) ──────────
# Same convention as ROOFIX_DB_*: default password is baked into compose
# for dev; override before exposing anything past sandbox_state. The DB
# lives on the sandbox_state Docker network which is `internal: true` —
# there is no route from ai_shared or sandbox_net.
SANDBOX_DB_USER=sandbox
SANDBOX_DB_PASSWORD=sandbox
SANDBOX_DB_NAME=sandbox

# ── n8n subsystem ────────────────────────────────────────────────────────────
# Self-hosted workflow engine. Reached at ${N8N_EDITOR_BASE_URL} via a
# DEDICATED oauth2-proxy instance (oauth2-proxy-n8n, defined in
# ai/oauth2-proxy/docker-compose.oauth2-proxy.yml alongside the shared
# openwebui-side instance) on its own subdomain. n8n's built-in subpath
# routing (N8N_PATH=/n8n/) is broken upstream (n8n-io/n8n#19635, #18596) as
# of 1.108.2 — static assets hit the SPA fallback and return HTML instead of
# JS/CSS. Subdomain sidesteps the bug entirely. See ai/n8n/N8N.md § "Public
# routing".
#
# REQUIRED before first start. Encrypts every stored credential at rest in
# Postgres. Losing this key destroys all stored credentials — workflow rows
# survive but their auth blobs become unreadable. Generate with:
#     openssl rand -hex 32
# Then paste the value below and back it up alongside your other secrets.
N8N_ENCRYPTION_KEY=

# n8n-db (compose-managed Postgres). Same convention as ROOFIX_DB_* /
# SANDBOX_DB_*: default password is baked into compose for dev; override
# before exposing PORT_N8N_DB past the host. The DB lives on ai_shared —
# not on an internal-only network.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n
N8N_DB_NAME=n8n

# Postgres persistence backend. `postgresdb` = use n8n-db above.
# `sqlite` would drop the n8n-db dependency but you would lose Postgres-side
# operator queries and JSONB filtering.
N8N_DB_TYPE=postgresdb

# Docker service DNS name + internal port for n8n-db on ai_shared. Do NOT
# change without also renaming the service in ai/n8n/docker-compose.n8n.yml.
N8N_DB_HOST=n8n-db
N8N_DB_INTERNAL_PORT=5432

# Public hostname + protocol the editor lives at. n8n runs at root — the
# whole n8n.zeoenergy.com subdomain belongs to it — because subpath routing
# is broken upstream (see banner comment above).
N8N_HOST=n8n.zeoenergy.com
N8N_PROTOCOL=https
N8N_INTERNAL_PORT=5678
N8N_PATH=/

# Editor URL and outgoing webhook URL. n8n bakes both into HTML and webhook
# payloads, so they MUST resolve to what the browser actually sees coming out
# of cloudflared + oauth2-proxy-n8n. Keep in sync with N8N_HOST above.
N8N_EDITOR_BASE_URL=https://n8n.zeoenergy.com/
N8N_WEBHOOK_URL=https://n8n.zeoenergy.com/

# Two proxy hops in front of us: cloudflared, then oauth2-proxy-n8n. n8n
# walks that many entries back through X-Forwarded-For / -Proto to trust the
# real client IP + scheme. Adjust only if the ingress topology changes.
N8N_PROXY_HOPS=2

# Keep n8n's local user-management on so the first browser hit can create the
# owner account. oauth2-proxy already gates who reaches the editor via the
# zeoai.access@ Google group; the n8n account is a second per-user identity
# layer inside the app.
N8N_USER_MANAGEMENT_DISABLED=false

# Phone-home diagnostics + hiring banner. Neither belongs in an internal
# deployment.
N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false

# Task runners execute Code nodes in a separate process for isolation.
# Currently opt-in with a deprecation warning; will be default-on in a
# future n8n release. Enable now to silence the warning and future-proof.
# See https://docs.n8n.io/hosting/configuration/task-runners/
N8N_RUNNERS_ENABLED=true

# AI-node defaults. n8n's LangChain / OpenAI credential picker uses these so
# operators don't paste the LiteLLM base URL per workflow. Point at LiteLLM
# on ai_shared — NOT localhost. The corresponding API key is read from
# DEFAULT_LITELLM_MASTER_KEY (defined further up in the LiteLLM block).
N8N_AI_OPENAI_API_BASE=http://litellm:4000/v1

# Timezone applied to both n8n's cron scheduler (GENERIC_TIMEZONE) and the
# container's system clock (TZ). Use an IANA name.
N8N_TIMEZONE=America/New_York

# ── oauth2-proxy-n8n (dedicated SSO gate in front of n8n) ────────────────────
# Second oauth2-proxy instance colocated in ai/n8n/docker-compose.n8n.yml.
# Everything not listed below is inherited from the OAUTH2_PROXY_* block far
# above (provider, client id/secret, group gating, SA-key path, templates
# dir, cookie expire/refresh, etc.) — one Google OAuth client, one access
# group, two instances.
#
# BEFORE FIRST START, do TWO things:
#   1. Add https://n8n.zeoenergy.com/oauth2/callback as an authorized
#      redirect URI on the existing Google OAuth 2.0 client (same client
#      openwebui uses — Console → APIs & Services → Credentials).
#   2. Add a Cloudflare tunnel public hostname n8n.zeoenergy.com → HTTP
#      → oauth2-proxy-n8n:4180.

# 32-byte URL-safe base64 cookie signing secret — MUST be distinct from
# OAUTH2_PROXY_COOKIE_SECRET so the two instances sign independently.
# Generate with (PowerShell):
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b) -replace '\+','-' -replace '/','_'
# Or (POSIX): openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_N8N_COOKIE_SECRET=

# Distinct cookie name so the browser sends the right cookie to the right
# host. Both cookies coexist happily under different domains.
OAUTH2_PROXY_N8N_COOKIE_NAME=_oauth2_proxy_n8n

# n8n subdomain scope. Must match N8N_HOST + the Google-registered redirect.
OAUTH2_PROXY_N8N_COOKIE_DOMAINS=n8n.zeoenergy.com
OAUTH2_PROXY_N8N_REDIRECT_URL=https://n8n.zeoenergy.com/oauth2/callback

# SameSite=lax: n8n is never iframed anywhere, so the SameSite=none dance
# that the shared oauth2-proxy needs (sandbox iframes inside OpenWebUI)
# doesn't apply here. Lax is the tighter default.
OAUTH2_PROXY_N8N_COOKIE_SAMESITE=lax

# Single upstream — n8n on ai_shared. No path prefix, no fanout.
OAUTH2_PROXY_N8N_UPSTREAMS=http://n8n:5678