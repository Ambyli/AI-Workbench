* text=auto
*.sh text eol=lf
Dockerfile text eol=lf

# Config files read inside Linux containers must stay LF — CRLF trailing
# on `Port 8888\r` or a Caddy directive breaks the parser at container
# start with no useful diagnostic. Force LF on checkout regardless of
# core.autocrlf so Windows editors can't silently re-CRLF them.
*.Dockerfile text eol=lf
Dockerfile.* text eol=lf
Caddyfile text eol=lf
*.conf text eol=lf
*.filter text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.jinja text eol=lf
*.py text eol=lf
*.toml text eol=lf
entrypoint.sh text eol=lf
# Vendored Supabase config (ai/supabase/volumes/). The Postgres init scripts
# use psql's backtick `\set x \`echo "$VAR"\`` trick, which a trailing \r turns
# into a value with a carriage return baked in — a role password that silently
# doesn't match. Envoy's pooler.exs and the Deno function sources are read by
# runtimes with the same intolerance.
*.sql text eol=lf
*.exs text eol=lf
*.ts text eol=lf
*.jsonc text eol=lf
