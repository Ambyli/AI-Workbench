# Git
.git
.gitignore

# Python cache & environments
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
env
*.egg-info
.pytest_cache

# Environment secrets
.env
.env.*
!.env.example
*.key

# IDE / OS
.DS_Store
Thumbs.db
.idea
.vscode
.claude

# Runtime data / temp
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/chat_notifications.json

# Nested checkout of the website repo (its own git repo; never part of this repo or image)
New-Zeo-Website/

# Runtime data must never be baked into the image (S-M6/S-M7); it lives on a volume.
backend/data/*.json
!backend/data/customers.json
# Tests, docs and local tooling don't belong in the runtime image.
tests/
docs/
scripts/
*.md
!README.md

# Credential files must never be committed or baked into images (S-L7).
*credentials*.json
*service-account*.json
*service_account*.json
*-sa.json
sa-key.json
*.pem
