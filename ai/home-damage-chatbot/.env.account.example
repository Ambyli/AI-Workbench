# ---------------------------------------------------------------------------
# Account service (backend/account_service.py) — the gapped side of the account
# check. Copy to .env.account (git-ignored). This file holds the CRM and delivery
# secrets; the customer-facing chatbot's .env must NOT contain any of them.
# The service needs no model key. Start it with ZEO_ENV_FILE=.env.account.
# ---------------------------------------------------------------------------

# Shared secret the chatbot sends as X-Internal-Key (scripts/mock-start.ps1 generates one per run).
ACCOUNT_SERVICE_KEY=

# CRM: stub (synthetic mock accounts) | phoenix (read-only DB role)
CRM_BACKEND=stub
CRM_DB_URL=
CRM_QUERY_TIMEOUT_SECONDS=3
CRM_ADDRESS_MIN_SCORE=55
CRM_NAME_MIN_SCORE=65
CRM_STREET_MIN_SIMILARITY=0.3
CRM_MATCH_MARGIN=5

# Delivery (off by default; the mock forces these off)
EMAIL_SEND_ENABLED=false
GOOGLE_SA_CREDENTIALS_FILE=
GOOGLE_DELEGATED_USER=
CHAT_SEND_ENABLED=false
CHAT_WEBHOOK_DISPOSITION=
CHAT_WEBHOOK_UNVERIFIED=
CHAT_WEBHOOK_SOLAR=

RETENTION_DAYS=30
