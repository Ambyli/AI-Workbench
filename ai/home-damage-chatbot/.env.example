# Zeo Energy Service Chatbot — configuration template.
# Copy to `.env` (which is git-ignored) and fill in real values. Every key below
# is read by backend/config.py. Defaults are safe for local/prototype use.

# ---------------------------------------------------------------------------
# LLM Provider: vllm (default for production/docker) | ollama | mock
# Use USE_MOCK_LLM=1 or LLM_BACKEND=mock for offline testing without a model.
# ---------------------------------------------------------------------------
LLM_BACKEND=vllm
LLM_TIMEOUT_SECONDS=60
USE_MOCK_LLM=0

# vLLM Server Configuration (OpenAI-compatible /v1 endpoint)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen3.8:27b
VLLM_API_KEY=

# Ollama Server Configuration (Alternative / local dev)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# ---------------------------------------------------------------------------
# HTTP / CORS — comma-separated allow-list of browser origins.
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Rate limiting (fixed window per client IP).
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# User Concurrency & Queueing — limits active users and queues overflow.
# ---------------------------------------------------------------------------
MAX_ACTIVE_USERS=25
MAX_QUEUE_SIZE=100
ACTIVE_SESSION_TIMEOUT_SECONDS=300
QUEUE_POLL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Session hygiene (in-memory store).
# ---------------------------------------------------------------------------
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=5000

# ---------------------------------------------------------------------------
# Answer-validation gate. Minimum LLM "is this responsive?" confidence (0..1)
# required before a free-text/identity answer is accepted.
# ---------------------------------------------------------------------------
ANSWER_CONFIDENCE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# CRM (in-house — documentation pending). Backend selects the adapter:
#   stub    -> local placeholder over data/customers.json (default, for dev)
#   mcp     -> call the in-house CRM MCP server (wire up when docs land)
#   inhouse -> call the in-house CRM REST API directly
# CRM_MATCH_THRESHOLD is the fuzzy-but-high-confidence floor for a name+address match.
# ---------------------------------------------------------------------------
CRM_BACKEND=stub
CRM_MATCH_THRESHOLD=0.9
CRM_MCP_URL=
CRM_API_BASE_URL=
CRM_API_KEY=

# ---------------------------------------------------------------------------
# Email (Google Workspace / Gmail API via service account + domain-wide
# delegation). EMAIL_SEND_ENABLED=false keeps everything in the in-memory Inbox
# (no real mail leaves the box) — flip to true only with creds configured.
# ---------------------------------------------------------------------------
EMAIL_SEND_ENABLED=false
EMAIL_FROM=service-bot@zeoenergy.com
GOOGLE_SA_CREDENTIALS_FILE=
GOOGLE_DELEGATED_USER=
# Draft-then-send (true, default) creates a Gmail draft then sends it; false
# sends directly. Photos the homeowner uploaded are attached to the email.
GMAIL_CREATE_DRAFT=true

# ---------------------------------------------------------------------------
# Routing mailboxes — where the generated handoff email is addressed.
# ---------------------------------------------------------------------------
MAILBOX_DISPOSITION=service-team@zeoenergy.com
MAILBOX_UNVERIFIED=intake-review@zeoenergy.com
MAILBOX_SOLAR=performance-team@zeoenergy.com

# ---------------------------------------------------------------------------
# Google Chat notifications — ping the routed team's space in addition to the
# email. CHAT_SEND_ENABLED=false records to an in-app feed (no network, no
# creds). Set true + CHAT_BACKEND=webhook and paste each team's Google Chat
# incoming-webhook URL below to post real cards. (Webhooks can't carry files,
# so photos stay on the email; the card reports the attachment count.)
#   CHAT_BACKEND: stub (default) | webhook | api
# ---------------------------------------------------------------------------
CHAT_SEND_ENABLED=false
CHAT_BACKEND=stub
CHAT_WEBHOOK_DISPOSITION=
CHAT_WEBHOOK_UNVERIFIED=
CHAT_WEBHOOK_SOLAR=
