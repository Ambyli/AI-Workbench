# Open WebUI with Zeo patches applied on top of the pinned upstream release.
#
# Why a custom image: some deployment needs cannot be met from .env alone.
# Each such change is a numbered unified diff in ai/openwebui/patches/, and
# this file is the ONLY place they are applied. Nothing else about the
# upstream image changes — same entrypoint, same layout, same user.
#
# Build:   make build openwebui         (compose: build context is the repo
#          root, so patches/ is addressable as ai/openwebui/patches/)
# Bump:    edit OPENWEBUI_VERSION in .env, run `make build openwebui`, then
#          `make up openwebui`. A patch that no longer applies FAILS the
#          build loudly at the --dry-run step below — that is deliberate.
#          Regenerate the patch against the new tag (OPENWEBUI.md § Custom
#          image) rather than forcing it.
#
# Current patches:
#   0002-trusted-header-google-identity.patch — WEBUI_AUTH_TRUSTED_ACCESS_TOKEN_HEADER:
#       in trusted-header SSO mode, verify the identity oauth2-proxy asserts
#       against Google (tokeninfo: live, aud == GOOGLE_CLIENT_ID, e-mail
#       matches) using the forwarded access token, and take the display name
#       and profile picture from Google's userinfo — on account creation and
#       on every sign-in. Touches backend/open_webui/env.py,
#       routers/auths.py, and adds utils/trusted_proxy.py.
#   0003-oauth-mcp-defaults-no-redirect.patch — a model's default OAuth MCP
#       tools (Phoenix) stay in a user's GET /api/models toolIds only while
#       that user holds a token the MCP server accepts (probed, cached 60 s),
#       so opening a chat never redirects to the MCP server's authorize page
#       (users it does not authorise were stranded on its "not authorised"
#       page). Also makes OAuthClientManager.get_oauth_token refresh
#       single-flight and delete a session only when it can never be renewed:
#       the page-load race between /api/models and /api/v1/tools used to
#       delete a valid session on every access-token expiry. Touches
#       backend/open_webui/main.py and utils/oauth.py, adds
#       utils/mcp_oauth_defaults.py.
#   0004-auto-continue-announced-tool-calls.patch — with native function
#       calling, a model that ends a turn right after a tool result by
#       ANNOUNCING its next step ("I'll rewrite the file and re-run.") instead
#       of making the tool call gets a hidden nudge and a continuation, up to
#       AUTO_CONTINUE_MAX_NUDGES times per turn (0 = off). The continuation is
#       appended to the same assistant message; the nudge is never shown or
#       saved. Touches backend/open_webui/utils/middleware.py, adds
#       utils/zeo_auto_continue.py.
#   0005-forward-message-id-header.patch — with ENABLE_FORWARD_USER_INFO_HEADERS
#       on, a chat-completions request to an OpenAI-compatible connection
#       (LiteLLM) carries X-OpenWebUI-Message-Id (the assistant message id)
#       beside upstream's X-OpenWebUI-Chat-Id, so LiteLLM can tie a request to
#       the chat turn it answers. Upstream sends the message id to tool
#       servers only. Touches backend/open_webui/utils/headers.py (where
#       get_headers_and_cookies has lived since v0.12; routers/openai.py before).

ARG OPENWEBUI_VERSION=v0.12.3
FROM ghcr.io/open-webui/open-webui:${OPENWEBUI_VERSION}

# Upstream ends its Dockerfile with `USER $UID:$GID`, 0:0 by default, so we
# are root here and can write under /app. `patch` ships with build-essential,
# which upstream installs; the `command -v` guard makes a future base image
# that drops it fail with an obvious message instead of a confusing one.
COPY ai/openwebui/patches/*.patch /tmp/zeo-patches/

# Three checks per build, each of which fails the build on its own:
#   1. --dry-run: every hunk of every patch still matches upstream's code.
#   2. compile: every patched module still compiles (catches a half-applied
#      hunk, or a nested hook whose `nonlocal` names a variable upstream
#      renamed, that would otherwise only surface at container start).
#   3. grep: the feature is really present (catches a patch that applied to
#      the wrong context and changed nothing that matters).
RUN set -eu; \
    command -v patch >/dev/null || { echo "patch(1) missing from base image" >&2; exit 1; }; \
    cd /app; \
    for p in /tmp/zeo-patches/*.patch; do \
        echo "==> $(basename "$p")"; \
        patch -p1 --forward --dry-run < "$p"; \
        patch -p1 --forward < "$p"; \
    done; \
    python3 -c 'import sys; [compile(open(f).read(), f, "exec") for f in sys.argv[1:]]' \
        backend/open_webui/env.py \
        backend/open_webui/routers/auths.py \
        backend/open_webui/utils/trusted_proxy.py \
        backend/open_webui/main.py \
        backend/open_webui/utils/oauth.py \
        backend/open_webui/utils/mcp_oauth_defaults.py \
        backend/open_webui/utils/middleware.py \
        backend/open_webui/utils/zeo_auto_continue.py \
        backend/open_webui/utils/headers.py; \
    grep -q "verify_google_identity" backend/open_webui/routers/auths.py; \
    grep -q "drop_unconnected_oauth_tool_defaults" backend/open_webui/main.py; \
    grep -q "_zeo_refresh_single_flight" backend/open_webui/utils/oauth.py; \
    grep -q "zeo_auto_continue_round" backend/open_webui/utils/middleware.py; \
    grep -qF "headers[FORWARD_SESSION_INFO_HEADER_MESSAGE_ID]" backend/open_webui/utils/headers.py; \
    rm -rf /tmp/zeo-patches

# Record the base and the patch set on the image so `docker image inspect`
# can tell a patched build from a stock one.
ARG OPENWEBUI_VERSION
LABEL org.opencontainers.image.base.name="ghcr.io/open-webui/open-webui:${OPENWEBUI_VERSION}" \
      com.zeoenergy.openwebui.patches="0002-trusted-header-google-identity,0003-oauth-mcp-defaults-no-redirect,0004-auto-continue-announced-tool-calls,0005-forward-message-id-header"
