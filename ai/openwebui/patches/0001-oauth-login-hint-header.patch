Zeo patch 0001 — forward a proxy-verified identity as OIDC login_hint.

Target: Open WebUI v0.11.3 (ghcr.io/open-webui/open-webui:v0.11.3).
Applied by ai/openwebui/Dockerfile.openwebui with `patch -p1` from /app.
Adds env var OAUTH_LOGIN_HINT_HEADER (default empty = feature off).
See ai/openwebui/OPENWEBUI.md § Custom image for rationale and upgrade steps.

--- a/backend/open_webui/env.py	2026-09-10 16:14:20.428855600 -0600
+++ b/backend/open_webui/env.py	2026-09-10 16:14:20.606687400 -0600
@@ -786,6 +786,13 @@
 
 WEBUI_AUTH_TRUSTED_EMAIL_HEADER = os.getenv('WEBUI_AUTH_TRUSTED_EMAIL_HEADER', None)
 WEBUI_AUTH_TRUSTED_NAME_HEADER = os.getenv('WEBUI_AUTH_TRUSTED_NAME_HEADER', None)
+
+# ZEO PATCH (ai/openwebui/patches/0001-oauth-login-hint-header.patch).
+# Name of a request header whose value is forwarded to the OAuth provider as
+# the OIDC `login_hint` on /oauth/{provider}/login. Lets an authenticating
+# reverse proxy (oauth2-proxy: X-Forwarded-Email) pre-select the account so
+# the provider skips its account chooser. Hint only — never used for auth.
+OAUTH_LOGIN_HINT_HEADER = os.getenv('OAUTH_LOGIN_HINT_HEADER', '').strip()
 WEBUI_AUTH_TRUSTED_GROUPS_HEADER = os.getenv('WEBUI_AUTH_TRUSTED_GROUPS_HEADER', None)
 WEBUI_AUTH_TRUSTED_ROLE_HEADER = os.getenv('WEBUI_AUTH_TRUSTED_ROLE_HEADER', None)
 
--- a/backend/open_webui/utils/oauth.py	2026-09-10 16:14:20.461974700 -0600
+++ b/backend/open_webui/utils/oauth.py	2026-09-10 16:14:20.627081100 -0600
@@ -71,6 +71,7 @@
     ENABLE_OAUTH_EMAIL_FALLBACK,
     ENABLE_OAUTH_ID_TOKEN_COOKIE,
     OAUTH_CLIENT_INFO_ENCRYPTION_KEY,
+    OAUTH_LOGIN_HINT_HEADER,
     OAUTH_MAX_SESSIONS_PER_USER,
     WEBUI_AUTH_COOKIE_SAME_SITE,
     WEBUI_AUTH_COOKIE_SECURE,
@@ -1845,6 +1846,14 @@
         if OAUTH_AUTHORIZE_PARAMS:
             kwargs.update(OAUTH_AUTHORIZE_PARAMS)
 
+        # ZEO PATCH: forward the identity an upstream auth proxy has already
+        # verified as the OIDC login_hint, so the provider selects that
+        # session instead of showing an account chooser on this second hop.
+        if OAUTH_LOGIN_HINT_HEADER:
+            login_hint = (request.headers.get(OAUTH_LOGIN_HINT_HEADER) or '').strip()
+            if login_hint:
+                kwargs['login_hint'] = login_hint
+
         return await client.authorize_redirect(request, redirect_uri, **kwargs)
 
     async def handle_callback(self, request, provider, response, db=None):
