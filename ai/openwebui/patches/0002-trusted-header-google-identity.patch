+"""ZEO PATCH — ai/openwebui/patches/0002-trusted-header-google-identity.patch.
+
+Verify and enrich a trusted-header sign-in using the Google access token the
+authenticating reverse proxy forwards (oauth2-proxy `--pass-access-token`,
+header `X-Forwarded-Access-Token`).
+
+Upstream's trusted-header mode believes WEBUI_AUTH_TRUSTED_EMAIL_HEADER
+unconditionally and has no source for a display name or a profile picture.
+This module asks Google instead:
+
+  1. tokeninfo — the token must be live, issued to OUR OAuth client
+     (aud == GOOGLE_CLIENT_ID), and belong to the same verified e-mail the
+     proxy asserts. Any failure refuses the sign-in with HTTP 401.
+  2. userinfo  — the account's `name` and `picture`. Failure here is not
+     fatal: identity was already verified, the caller just gets no name.
+
+A header-only spoof therefore no longer works even for a caller that can
+reach openwebui:8080 directly — they would need the victim's live Google
+access token for this application.
+"""
+
+import logging
+from typing import Any
+
+import aiohttp
+from fastapi import HTTPException, status
+from open_webui.config import GOOGLE_CLIENT_ID
+from open_webui.env import AIOHTTP_CLIENT_SESSION_SSL
+
+log = logging.getLogger(__name__)
+
+GOOGLE_TOKENINFO_URL = 'https://oauth2.googleapis.com/tokeninfo'
+GOOGLE_USERINFO_URL = 'https://openidconnect.googleapis.com/v1/userinfo'
+_TIMEOUT = aiohttp.ClientTimeout(total=10)
+
+
+def _refuse(reason: str) -> HTTPException:
+    log.warning('Trusted-header sign-in refused: %s', reason)
+    return HTTPException(
+        status.HTTP_401_UNAUTHORIZED,
+        detail='Sign-in could not be verified with Google. Please sign in again.',
+    )
+
+
+async def verify_google_identity(access_token: str, expected_email: str) -> dict[str, str]:
+    """Return {'email', 'name', 'picture'} for a live Google access token.
+
+    Raises HTTPException(401) unless Google confirms the token is valid, was
+    issued to GOOGLE_CLIENT_ID (when set), and belongs to `expected_email`.
+    `name` / `picture` are empty strings when userinfo is unavailable.
+    """
+    access_token = (access_token or '').strip()
+    expected_email = (expected_email or '').strip().lower()
+    if not access_token:
+        raise _refuse('no access token header on the request')
+
+    async with aiohttp.ClientSession(timeout=_TIMEOUT) as session:
+        try:
+            async with session.get(
+                GOOGLE_TOKENINFO_URL,
+                params={'access_token': access_token},
+                ssl=AIOHTTP_CLIENT_SESSION_SSL,
+            ) as resp:
+                if resp.status != 200:
+                    raise _refuse(f'tokeninfo returned HTTP {resp.status}')
+                info: dict[str, Any] = await resp.json()
+        except aiohttp.ClientError as e:
+            raise _refuse(f'tokeninfo unreachable: {e}')
+
+        if GOOGLE_CLIENT_ID and info.get('aud') != GOOGLE_CLIENT_ID:
+            raise _refuse('token was not issued to this application (aud mismatch)')
+
+        token_email = str(info.get('email') or '').strip().lower()
+        if not token_email or token_email != expected_email:
+            raise _refuse('token e-mail does not match the asserted e-mail')
+        # tokeninfo returns this as the string "true", not a JSON boolean.
+        if str(info.get('email_verified', '')).lower() != 'true':
+            raise _refuse('token e-mail is not verified by Google')
+
+        name = ''
+        picture = ''
+        try:
+            async with session.get(
+                GOOGLE_USERINFO_URL,
+                headers={'Authorization': f'Bearer {access_token}'},
+                ssl=AIOHTTP_CLIENT_SESSION_SSL,
+            ) as resp:
+                if resp.status == 200:
+                    profile: dict[str, Any] = await resp.json()
+                    name = str(profile.get('name') or '').strip()
+                    picture = str(profile.get('picture') or '').strip()
+                else:
+                    log.warning('Google userinfo returned HTTP %s; signing in without name/picture', resp.status)
+        except aiohttp.ClientError as e:
+            log.warning('Google userinfo unreachable (%s); signing in without name/picture', e)
+
+    return {'email': token_email, 'name': name, 'picture': picture}
