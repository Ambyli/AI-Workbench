+"""ZEO PATCH (ai/openwebui/patches/0003-oauth-mcp-defaults-no-redirect.patch).
+
+A model's default OAuth MCP tools (Phoenix) follow the user's real
+connection: on in every new chat while the MCP server accepts the user's
+token, off — with no redirect — while it does not.
+
+Upstream: when a new chat opens on a model whose default tools
+(``info.meta.toolIds``) include an OAuth 2.1 MCP server the user has no
+token for, the chat page (``Chat.svelte`` ``setDefaults``) navigates
+straight to ``/oauth/clients/mcp:<id>/authorize`` and then refuses to send
+any message until the integration is connected. For a user the MCP server
+does not authorise, that is a dead end on the server's "not authorised"
+page, every time they open a chat.
+
+This module filters such tool ids out of the model list returned to THAT
+user (``GET /api/models``). A tool stays a default only when both hold:
+
+1. **A token.** ``oauth_client_manager.get_oauth_token`` — the call
+   ``GET /api/v1/tools`` derives its ``authenticated`` flag from, renewing an
+   expiring token. The renewal is single-flight; see the ``oauth.py`` hunk of
+   this patch for the race that used to disconnect users here.
+2. **The MCP server accepts it.** An ``initialize`` request is sent with the
+   headers a real tool call sends (``build_tool_server_headers``). A 401, or
+   a 403 whose ``WWW-Authenticate`` names ``invalid_token`` /
+   ``insufficient_scope``, is a refusal: the token is renewed once and asked
+   again, and a second refusal deletes the session, so the Integrations menu
+   shows the tool's "connect" state and ``GET /api/v1/tools`` agrees.
+   No answer (timeout, connection error, 5xx, 429, a bare 403 from a proxy)
+   proves nothing either way: the tool is left out for now but the session is
+   kept, so it comes back by itself once the server answers.
+
+Upstream redirects only when a tool is BOTH in the defaults AND
+``authenticated: false`` in ``GET /api/v1/tools``. A tool is kept here only
+with a live session the server accepted, and a session is deleted only on a
+path that has already dropped the tool, so that pair cannot be produced.
+
+Verdicts are cached per (user, server) against the access token they were
+reached with — accepted for ``_ACCEPTED_TTL_S``, anything else for
+``_UNSETTLED_TTL_S`` — and concurrent lookups share one check, because the
+app requests the model list several times on every page load. The whole
+check is bounded by ``_CHECK_TIMEOUT_S`` so a hung MCP server cannot stall
+the model list; a check that outlives it finishes in the background and
+fills the cache.
+
+Only the response is changed: model rows in the DB and ``app.state.MODELS``
+are never mutated.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import logging
+import time
+
+import aiohttp
+from fastapi import Request
+from mcp.types import LATEST_PROTOCOL_VERSION
+from open_webui.env import AIOHTTP_CLIENT_SESSION_SSL
+from open_webui.models.config import Config
+from open_webui.models.oauth_sessions import OAuthSessions
+
+log = logging.getLogger(__name__)
+
+_OAUTH_AUTH_TYPES = ('oauth_2.1', 'oauth_2.1_static')
+
+_ACCEPTED_TTL_S = 60
+_UNSETTLED_TTL_S = 15
+_PROBE_TIMEOUT_S = 4
+_CHECK_TIMEOUT_S = 6
+
+ACCEPTED, REJECTED, UNREACHABLE = 'accepted', 'rejected', 'unreachable'
+
+# (user id, oauth client id) -> (monotonic expiry, access-token fingerprint, verdict)
+_verdicts: dict[tuple[str, str], tuple[float, str, str]] = {}
+_in_flight: dict[tuple[str, str], asyncio.Task] = {}
+
+
+def _fingerprint(token: dict | None) -> str:
+    access_token = (token or {}).get('access_token') or ''
+    return hashlib.sha256(access_token.encode()).hexdigest()[:16]
+
+
+async def _probe(url: str, headers: dict, cookies: dict) -> str:
+    """Ask the MCP server whether it accepts these credentials."""
+    request_headers = {
+        **headers,
+        'Accept': 'application/json, text/event-stream',
+        'Content-Type': 'application/json',
+    }
+    body = {
+        'jsonrpc': '2.0',
+        'id': 0,
+        'method': 'initialize',
+        'params': {
+            'protocolVersion': LATEST_PROTOCOL_VERSION,
+            'capabilities': {},
+            'clientInfo': {'name': 'open-webui-auth-probe', 'version': '1'},
+        },
+    }
+    try:
+        async with aiohttp.ClientSession(
+            trust_env=True,
+            timeout=aiohttp.ClientTimeout(total=_PROBE_TIMEOUT_S),
+            cookies=cookies or None,
+        ) as http:
+            async with http.post(url, json=body, headers=request_headers, ssl=AIOHTTP_CLIENT_SESSION_SSL) as r:
+                status = r.status
+                challenge = r.headers.get('WWW-Authenticate', '').lower()
+                mcp_session_id = r.headers.get('Mcp-Session-Id')
+            if mcp_session_id:
+                # End the session the probe opened rather than leave it to time out.
+                try:
+                    async with http.delete(
+                        url,
+                        headers={**request_headers, 'Mcp-Session-Id': mcp_session_id},
+                        ssl=AIOHTTP_CLIENT_SESSION_SSL,
+                    ):
+                        pass
+                except Exception:
+                    pass
+    except Exception as e:
+        log.info(f'MCP auth probe of {url} got no answer: {type(e).__name__}: {e}')
+        return UNREACHABLE
+
+    if status == 401 or (status == 403 and ('invalid_token' in challenge or 'insufficient_scope' in challenge)):
+        return REJECTED
+    if status in (403, 408, 429) or status >= 500:
+        log.info(f'MCP auth probe of {url} was inconclusive: HTTP {status}')
+        return UNREACHABLE
+    return ACCEPTED
+
+
+async def _check(request: Request, user, server: dict, client_id: str) -> str:
+    # Imported here, not at module level: utils.tools pulls in most of the app.
+    from open_webui.utils.tools import build_tool_server_headers
+
+    manager = request.app.state.oauth_client_manager
+    key = (user.id, client_id)
+    info_id = (server.get('info') or {}).get('id')
+    url = server.get('url', '')
+
+    token = await manager.get_oauth_token(user.id, client_id)
+    if not token:
+        return REJECTED  # no session, or one that could never be renewed
+
+    fingerprint = _fingerprint(token)
+    cached = _verdicts.get(key)
+    if cached and cached[0] > time.monotonic() and cached[1] == fingerprint:
+        return cached[2]
+
+    headers, cookies = await build_tool_server_headers(server, request, user, server_id=info_id)
+    verdict = await _probe(url, headers, cookies)
+
+    if verdict == REJECTED:
+        # The server refused a token Open WebUI thinks is valid (revoked,
+        # signing key rotated, ...): renew it once and ask again.
+        renewed = await manager.get_oauth_token(user.id, client_id, force_refresh=True)
+        if not renewed:
+            log.info(f'MCP server refused {client_id} for user {user.id} and the token could not be renewed')
+            return REJECTED  # get_oauth_token has already deleted the session
+        if _fingerprint(renewed) != fingerprint:
+            fingerprint = _fingerprint(renewed)
+            headers, cookies = await build_tool_server_headers(server, request, user, server_id=info_id)
+            verdict = await _probe(url, headers, cookies)
+        elif renewed.get('refresh_token'):
+            # The same token back means the renewal did not complete (network,
+            # 5xx); the refresh token may still be good, so keep the session.
+            verdict = UNREACHABLE
+
+        if verdict == REJECTED:
+            session = await OAuthSessions.get_session_by_provider_and_user_id(client_id, user.id)
+            # Only the session holding the refused token: a reconnect from
+            # another tab since then must survive.
+            if session and _fingerprint(session.token) == fingerprint:
+                log.warning(f'MCP server refused {client_id} for user {user.id}; deleting session {session.id}')
+                await OAuthSessions.delete_session_by_id(session.id)
+
+    ttl = _ACCEPTED_TTL_S if verdict == ACCEPTED else _UNSETTLED_TTL_S
+    _verdicts[key] = (time.monotonic() + ttl, fingerprint, verdict)
+    return verdict
+
+
+async def _is_connected(request: Request, user, server: dict, client_id: str) -> bool:
+    key = (user.id, client_id)
+    task = _in_flight.get(key)
+    if task is None:
+        task = asyncio.create_task(_check(request, user, server, client_id))
+        _in_flight[key] = task
+        task.add_done_callback(lambda _task, key=key: _in_flight.pop(key, None))
+    try:
+        # shield: a caller that gives up must not cancel a token refresh mid-rotation.
+        return await asyncio.wait_for(asyncio.shield(task), _CHECK_TIMEOUT_S) == ACCEPTED
+    except asyncio.TimeoutError:
+        log.info(f'OAuth MCP check of {client_id} for user {user.id} still running; tool left off for now')
+        return False
+    except Exception as e:  # never fail the model list over this
+        log.warning(f'OAuth MCP check of {client_id} for user {user.id} failed: {type(e).__name__}: {e}')
+        return False
+
+
+def _tool_ids_of(model: dict) -> tuple[dict | None, dict | None, list | None]:
+    info = model.get('info') if isinstance(model.get('info'), dict) else None
+    meta = info.get('meta') if info and isinstance(info.get('meta'), dict) else None
+    tool_ids = meta.get('toolIds') if meta else None
+    return info, meta, tool_ids if isinstance(tool_ids, list) else None
+
+
+async def drop_unconnected_oauth_tool_defaults(request: Request, user, models: list[dict]) -> list[dict]:
+    # tool id ('server:mcp:<info.id>') -> (connection, oauth client id 'mcp:<last segment>'),
+    # built the same way routers/tools.py::get_tools builds them.
+    oauth_tools: dict[str, tuple[dict, str]] = {}
+    for server in await Config.get('tool_server.connections', []) or []:
+        if server.get('type', 'openapi') != 'mcp' or not (server.get('config') or {}).get('enable'):
+            continue
+        if server.get('auth_type', 'none') not in _OAUTH_AUTH_TYPES:
+            continue
+        info_id = (server.get('info') or {}).get('id')
+        if info_id:
+            oauth_tools[f'server:mcp:{info_id}'] = (server, f'mcp:{info_id.split(":")[-1]}')
+
+    if not oauth_tools:
+        return models
+
+    wanted = sorted({t for model in models for t in (_tool_ids_of(model)[2] or []) if t in oauth_tools})
+    if not wanted:
+        return models
+
+    # All servers at once: the slowest bounds the model list, not the sum.
+    results = await asyncio.gather(*(_is_connected(request, user, *oauth_tools[t]) for t in wanted))
+    connected = dict(zip(wanted, results))
+
+    result = []
+    for model in models:
+        info, meta, tool_ids = _tool_ids_of(model)
+        if tool_ids and any(t in oauth_tools for t in tool_ids):
+            kept = [t for t in tool_ids if t not in oauth_tools or connected[t]]
+            if len(kept) != len(tool_ids):
+                # Copy on write: these dicts are shared with app.state.MODELS.
+                model = {**model, 'info': {**info, 'meta': {**meta, 'toolIds': kept}}}
+
+        result.append(model)
+
+    return result
