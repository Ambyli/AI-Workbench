+"""ZEO PATCH (ai/openwebui/patches/0003-oauth-mcp-defaults-no-redirect.patch).
+
+Stops a model's default OAuth MCP tools from hijacking the page.
+
+Upstream: when a new chat opens on a model whose default tools
+(``info.meta.toolIds``) include an OAuth 2.1 MCP server the user has no
+token for, the chat page (``Chat.svelte`` ``setDefaults``) navigates
+straight to ``/oauth/clients/mcp:<id>/authorize`` and then refuses to send
+any message until the integration is connected. For a user the MCP server
+does not authorise, that is a dead end on the server's "not authorised"
+page, every time they open a chat.
+
+This module removes such tool ids from the model list returned to THAT user
+(``GET /api/models``), so the chat page never sees them as defaults: no
+redirect, no blocked send, the model simply runs without the tool. The tool
+stays listed in the chat's Integrations menu with its "connect" state, so a
+user the server does authorise connects once from there; from then on the
+token exists and the tool is a default again.
+
+"Connected" is decided exactly as ``GET /api/v1/tools`` decides its
+``authenticated`` flag (``oauth_client_manager.get_oauth_token``), so the two
+responses cannot disagree — a disagreement would put the redirect back.
+Only the response is changed: model rows in the DB and ``app.state.MODELS``
+are never mutated.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from fastapi import Request
+from open_webui.models.config import Config
+
+log = logging.getLogger(__name__)
+
+_OAUTH_AUTH_TYPES = ('oauth_2.1', 'oauth_2.1_static')
+
+
+async def drop_unconnected_oauth_tool_defaults(request: Request, user, models: list[dict]) -> list[dict]:
+    # tool id ('server:mcp:<info.id>') -> oauth client id ('mcp:<last segment>'),
+    # built the same way routers/tools.py::get_tools builds them.
+    oauth_tools: dict[str, str] = {}
+    for server in await Config.get('tool_server.connections', []) or []:
+        if server.get('type', 'openapi') != 'mcp' or not (server.get('config') or {}).get('enable'):
+            continue
+        if server.get('auth_type', 'none') not in _OAUTH_AUTH_TYPES:
+            continue
+        info_id = (server.get('info') or {}).get('id')
+        if info_id:
+            oauth_tools[f'server:mcp:{info_id}'] = f'mcp:{info_id.split(":")[-1]}'
+
+    if not oauth_tools:
+        return models
+
+    connected: dict[str, bool] = {}
+
+    async def is_connected(tool_id: str) -> bool:
+        if tool_id not in connected:
+            try:
+                token = await request.app.state.oauth_client_manager.get_oauth_token(user.id, oauth_tools[tool_id])
+            except Exception as e:  # never fail the model list over this
+                log.warning(f'OAuth token lookup failed for {tool_id}: {e}')
+                token = None
+            connected[tool_id] = token is not None
+        return connected[tool_id]
+
+    result = []
+    for model in models:
+        info = model.get('info') if isinstance(model.get('info'), dict) else None
+        meta = info.get('meta') if info and isinstance(info.get('meta'), dict) else None
+        tool_ids = meta.get('toolIds') if meta else None
+
+        if isinstance(tool_ids, list) and any(t in oauth_tools for t in tool_ids):
+            kept = [t for t in tool_ids if t not in oauth_tools or await is_connected(t)]
+            if len(kept) != len(tool_ids):
+                # Copy on write: these dicts are shared with app.state.MODELS.
+                model = {**model, 'info': {**info, 'meta': {**meta, 'toolIds': kept}}}
+
+        result.append(model)
+
+    return result
