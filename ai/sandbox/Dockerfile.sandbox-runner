# Build context is the REPO ROOT (see ai/docker-compose.sandbox.yml:
#   context: ..) so we can copy the shared workspace package alongside the
# service.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1 \
    PYTHONPATH=/app/ai/sandbox

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Workspace bootstrap: root pyproject declares the members; shared/common
# lands first so the service's `common` dep resolves via the workspace.
COPY pyproject.toml .
COPY shared/common ./shared/common
COPY ai/sandbox/pyproject.toml ./ai/sandbox/

# Sync only this service's dep graph (transitively pulls common).
RUN uv sync --package sandbox --no-dev

# Service code last so a code-only change doesn't invalidate the (slow)
# sync layer.
COPY ai/sandbox/app.py \
     ai/sandbox/spawner.py \
     ai/sandbox/runtimes.py \
     ai/sandbox/reaper.py \
     ai/sandbox/mcp.py \
     ./ai/sandbox/

WORKDIR /app/ai/sandbox
EXPOSE 8000

CMD ["uv", "run", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
