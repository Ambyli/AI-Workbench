# Base image for runtime="static" sandboxes — nginx serving whatever
# HTML/CSS/JS/asset files the runner put_archive'd into /app.
#
# Built by:   docker compose -f ai/docker-compose.sandbox.yml build sandbox-static
# Tag:        sandbox-static:latest  (referenced from runtimes.py)
#
# The base image is intentionally tiny — nginx:alpine + a config that
# points at /app. Anything the model wants to serve must land as a file
# in /app; there is no runtime install path in the static image.

FROM nginx:alpine

# nginx.conf: serve /app on port 80, no gzip config, minimal logging so a
# noisy static asset (favicon 404 storm etc.) doesn't fill sandbox logs.
COPY <<'CONF' /etc/nginx/conf.d/default.conf
server {
    listen 80 default_server;
    server_name _;

    root /app;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # nginx runs as `nginx` UID 101 by default, but Dockerfile.sandbox-runner
    # passes --user 1000:1000 for a non-root sandbox. Loosen /app perms so
    # the mounted tmpfs is readable regardless of what UID nginx ends up as.
    access_log /dev/stdout;
    error_log  /dev/stderr;
}
CONF

# Bake a placeholder index so a sandbox spawned with an empty files map
# still serves something instead of returning a naked 404. Runners always
# overwrite this via put_archive; it's just here so the readiness probe
# passes even if the caller sent no files (used by the compose smoke test).
RUN mkdir -p /app && \
    printf '<h1>sandbox ready</h1>\n' > /app/index.html && \
    chown -R 1000:1000 /app

# nginx normally runs as root to bind :80 (a privileged port). Since the
# runner sets --cap-drop ALL, we cannot bind :80 as an unprivileged user
# without CAP_NET_BIND_SERVICE. Use `setcap` here so uid 1000 can bind :80
# without any capability grant at container-runtime.
RUN apk add --no-cache libcap && \
    setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx && \
    apk del libcap

USER 1000:1000

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
