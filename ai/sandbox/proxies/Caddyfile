# sandbox-proxy — ingress reverse proxy for the sandbox subsystem.
#
# Routes two path shapes into the same backends:
#
#   /{sandbox_id}/*             — "bare" prefix, used by the host publish
#                                 (http://localhost:8011/{id}/) for
#                                 operator-local smoke tests.
#
#   /sandboxes/{sandbox_id}/*   — "namespaced" prefix. This is what
#                                 external browsers reach through the
#                                 cloudflared → oauth2-proxy → sandbox-proxy
#                                 hop. oauth2-proxy is configured with
#                                 http://sandbox-proxy:80/sandboxes/ in
#                                 OAUTH2_PROXY_UPSTREAMS, so requests to
#                                 chat.zeoenergy.com/sandboxes/{id}/…
#                                 arrive here with the same path prefix.
#
# In both cases we strip the matched prefix before forwarding to
# sandbox-{id}:80 so the sandbox app (Streamlit, Vite, nginx, …) always
# sees requests at "/" and doesn't need to know about a base path.
#
# WebSocket upgrades work by default; Streamlit and Vite HMR rely on this.
#
# The header manipulation below is what lets OpenWebUI iframe the served
# page. Sites that ship X-Frame-Options: DENY or a restrictive CSP would
# otherwise refuse to render in the chat panel.
#
# This build uses the caddyserver/replace-response plugin (baked in by
# ai/sandbox/proxies/Dockerfile) to inject a `<script>` tag into every
# HTML response — the shim it points at forwards browser console.error /
# console.warn / window.onerror / unhandled promise rejections back to
# sandbox-runner. See § Browser console capture in SANDBOX.md.

{
	# Silence the automatic HTTPS attempt — we're plain HTTP behind the
	# openwebui iframe, and the admin API is not exposed to sandbox_net.
	auto_https off
	admin off
}

# Shared reverse-proxy snippet — headers that let OpenWebUI iframe us
# AND force fresh fetches on every navigation. Sandbox contents change
# on every model call (put_archive rewrites /app), so any browser or
# intermediate cache serving a stale response makes hot-reload look
# broken. Cache-Control: no-store beats every layer of HTTP caching;
# clearing ETag/Last-Modified prevents conditional revalidation from
# short-circuiting to 304 Not Modified with the stale body.
(sandbox_headers) {
	header_down -X-Frame-Options
	header_down -Content-Security-Policy
	header_down Content-Security-Policy "frame-ancestors *"
	header_down Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header_down Pragma "no-cache"
	header_down Expires "0"
	header_down -ETag
	header_down -Last-Modified
}

# Reused replace-response snippet — injected into the two sandbox
# proxy handlers below. Only rewrites text/html responses (JSON, CSS,
# JS assets, images stay untouched). Streaming mode keeps memory usage
# flat regardless of page size.
#
# Search token includes the closing `>` so the replacement re-writes
# the entire `</head>` tag exactly. If a page has no </head> tag at
# all (rare — some frameworks serve fragments) the rewrite is a no-op
# and the shim is not injected. Documented in SANDBOX.md.
(inject_shim) {
	replace {
		stream
		match {
			header Content-Type text/html*
		}
		"</head>" `<script src="/__sandbox_shim__.js" defer></script></head>`
	}
}

:80 {
	# Health probe target for the compose healthcheck.
	handle /health {
		respond "ok" 200
	}

	# The shim itself — served directly by Caddy from the sandbox-proxy
	# image (COPY in Dockerfile). Matched EARLY so any sandbox_id that
	# happens to share the prefix can't shadow it. Cache-Control keeps
	# the browser from re-fetching on every navigation; the shim is
	# rebuilt only when the sandbox-proxy image is rebuilt.
	handle /__sandbox_shim__.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		root * /srv/shim
		try_files /browser_shim.js =404
		file_server
	}

	# Source-code download. Matched BEFORE the sandbox-id route so
	# `/sandboxes/download/{session_id}` is recognized as a download
	# request instead of getting parsed as a sandbox id. The runner
	# owns the export (needs docker.sock), so we reverse-proxy to it;
	# the browser gets the same oauth2-proxy auth model as previews.
	@sandbox_download path_regexp sandbox_download ^/sandboxes/download/(?P<session>[A-Za-z0-9_-]{1,64})$
	handle @sandbox_download {
		rewrite * /session/{re.sandbox_download.session}/download
		reverse_proxy sandbox-runner:8000
	}

	# Browser-log ingest — POST from the shim inside the sandbox app.
	# Matched BEFORE the general sandbox-id route so `_browser_log`
	# isn't forwarded into the container. Two forms: bare and
	# namespaced, mirroring the two forms of the sandbox URL prefix.
	# Body is JSON: {entries: [{level, ts, message, source?, line?, col?, stack?}, ...]}.
	# Runner responds 204 regardless of ingest result — we never
	# return a failure to the browser.
	@browser_log_ns path_regexp browser_log_ns ^/sandboxes/(?P<id>[a-f0-9]{12})/_browser_log$
	handle @browser_log_ns {
		rewrite * /internal/browser-log/{re.browser_log_ns.id}
		reverse_proxy sandbox-runner:8000
	}

	@browser_log path_regexp browser_log ^/(?P<id>[a-f0-9]{12})/_browser_log$
	handle @browser_log {
		rewrite * /internal/browser-log/{re.browser_log.id}
		reverse_proxy sandbox-runner:8000
	}

	# Namespaced path — this is the one external browsers use via
	# oauth2-proxy. Match FIRST so the bare /{id}/ pattern doesn't
	# accidentally interpret "sandboxes" as an id (it wouldn't — hex
	# won't match — but explicit ordering removes any doubt).
	@sandbox_ns path_regexp sandbox_ns ^/sandboxes/(?P<id>[a-f0-9]{12})(/.*)?$
	handle @sandbox_ns {
		uri strip_prefix /sandboxes/{re.sandbox_ns.id}
		reverse_proxy sandbox-{re.sandbox_ns.id}:80 {
			import sandbox_headers
		}
		import inject_shim
	}

	# Bare path — kept so `curl http://localhost:8011/{id}/` still
	# works for host-side debugging without going through oauth2-proxy.
	@sandbox path_regexp sandbox ^/(?P<id>[a-f0-9]{12})(/.*)?$
	handle @sandbox {
		uri strip_prefix /{re.sandbox.id}
		reverse_proxy sandbox-{re.sandbox.id}:80 {
			import sandbox_headers
		}
		import inject_shim
	}

	# Anything else — no sandbox matched. Do NOT act as an open proxy.
	respond "sandbox not found" 404
}
