{
  "$comment": "Request/response JSON Schemas (draft 2020-12) for searxng.postman_collection.json, rendered into its items' descriptions and SEARXNG_SCHEMAS.md (linked from SEARXNG.md). Edit here, then: uv run --no-sync python scripts/api_schemas.py render searxng. An OPEN subset (additionalProperties: true) of an upstream server, image docker.io/searxng/searxng:latest (NOT pinned: whatever `latest` the box pulled), read from searx/webapp.py, searx/webutils.py and searx/result_types/_base.py at 626105e (master, 2026-11-11): the unpinned tag has no release to point to. No request bodies (every call is a GET with query parameters). Checked by unit-tests/apidocs only (tier 1); an image change re-checks them.",
  "service": "searxng",
  "doc": "SEARXNG.md",
  "endpoints": {
    "GET /healthz": {
      "$comment": "searx/webapp.py at 626105e (master, 2026-11-11) health(); image docker.io/searxng/searxng:latest (NOT pinned: whatever `latest` the box pulled).",
      "responses": {
        "200": {
          "content_type": "text/plain",
          "description": "`OK`"
        }
      }
    },
    "GET /search": {
      "$comment": "searx/webapp.py at 626105e (master, 2026-11-11) search() and searx/webutils.py at 626105e (master, 2026-11-11) get_json_response; result fields from searx/result_types/_base.py at 626105e (master, 2026-11-11); image docker.io/searxng/searxng:latest (NOT pinned: whatever `latest` the box pulled).",
      "description": "With `format=json` (allowed by `search.formats` in settings.yml; a format not listed there is a 403); without it the HTML results page. `q` is required: none is a 400. Open WebUI reads `results[].url`, `title` and `content`.",
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "query",
              "results",
              "answers",
              "corrections",
              "infoboxes",
              "suggestions",
              "unresponsive_engines"
            ],
            "properties": {
              "query": {
                "type": "string"
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "A MainResult (or a legacy dict result) as `as_dict()` gives it",
                  "required": [
                    "url",
                    "title",
                    "content",
                    "engine"
                  ],
                  "properties": {
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string",
                      "description": "The snippet"
                    },
                    "engine": {
                      "type": "string",
                      "description": "The engine that returned it first"
                    },
                    "engines": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Every engine that returned it"
                    },
                    "score": {
                      "type": "number",
                      "description": "The merged rank; `results` is sorted by it"
                    },
                    "category": {
                      "type": "string"
                    },
                    "publishedDate": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "ISO 8601, when the engine gives one"
                    },
                    "thumbnail": {
                      "type": "string"
                    },
                    "img_src": {
                      "type": "string"
                    },
                    "template": {
                      "type": "string",
                      "description": "`default.html`, `images.html`, …"
                    },
                    "parsed_url": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "description": "urllib's six parts"
                    },
                    "positions": {
                      "description": "Its position in each engine's list"
                    }
                  }
                }
              },
              "answers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "corrections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "infoboxes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unresponsive_engines": {
                "type": "array",
                "description": "Engines that failed or timed out (`outgoing.max_request_timeout`), sorted",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "description": "The engine"
                    },
                    {
                      "type": "string",
                      "description": "Why, translated (`Suspended: …` when suspended)"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "400": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "string"
              }
            }
          },
          "description": "no `q` (`No query`), or a bad parameter"
        },
        "500": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "string"
              }
            }
          },
          "description": "`search error`"
        }
      }
    },
    "GET /": {
      "$comment": "searx/webapp.py at 626105e (master, 2026-11-11) index(); image docker.io/searxng/searxng:latest (NOT pinned: whatever `latest` the box pulled).",
      "responses": {
        "200": {
          "content_type": "text/html",
          "description": "the search page (a request carrying `q` is redirected to /search, 308)"
        }
      }
    },
    "GET /config": {
      "$comment": "searx/webapp.py at 626105e (master, 2026-11-11) config(); image docker.io/searxng/searxng:latest (NOT pinned: whatever `latest` the box pulled).",
      "description": "The running instance's settings. It does not list `search.formats`.",
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "categories",
              "engines",
              "plugins",
              "version"
            ],
            "properties": {
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "engines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "name",
                    "categories",
                    "enabled"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "shortcut": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean",
                      "description": "false for `duckduckgo` here (settings.yml)"
                    },
                    "paging": {
                      "type": "boolean"
                    },
                    "language_support": {
                      "type": "boolean"
                    },
                    "safesearch": {
                      "type": "boolean"
                    },
                    "time_range_support": {
                      "type": "boolean"
                    },
                    "timeout": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              },
              "plugins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "instance_name": {
                "type": "string"
              },
              "default_locale": {
                "type": "string"
              },
              "autocomplete": {
                "type": "string"
              },
              "safe_search": {
                "type": "integer"
              },
              "default_theme": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "limiter": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "false here (`server.limiter`)"
                  }
                }
              },
              "public_instance": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "GET /stats": {
      "$comment": "searx/webapp.py at 626105e (master, 2026-11-11) stats(); image docker.io/searxng/searxng:latest (NOT pinned: whatever `latest` the box pulled).",
      "description": "HTML only (there is no JSON variant); `/stats/errors` answers the same data as JSON.",
      "responses": {
        "200": {
          "content_type": "text/html",
          "description": "the engine statistics page"
        }
      }
    }
  }
}
