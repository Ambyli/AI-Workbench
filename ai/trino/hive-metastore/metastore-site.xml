<?xml version="1.0" encoding="UTF-8"?>
<!--
  HMS runtime config. Postgres backend for the metastore's own tables;
  S3A filesystem for Iceberg manifest validation against lake-s3 (RustFS).

  ${env.X} references are expanded by Hadoop's Configuration when HMS
  reads this file — nothing rewrites it (apache/hive:4.0.0's
  /entrypoint.sh never touches /opt/hive/conf). That is what lets
  docker-compose.trino.yml bind-mount it read-only over the COPYed copy.
-->
<configuration>
  <!-- ── Backing store (hive-metastore-db) ──────────────────────────── -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:postgresql://${env.HMS_DB_HOST}:${env.HMS_DB_PORT}/${env.HMS_DB_NAME}</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.postgresql.Driver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>${env.HMS_DB_USER}</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>${env.HMS_DB_PASSWORD}</value>
  </property>

  <!-- Default warehouse location on lake-s3. Iceberg tables get their own
       location under this prefix (s3a://warehouse/{db}/{table}/…). -->
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>s3a://warehouse/</value>
  </property>

  <!-- ── S3A filesystem pointing at lake-s3 ────────────────────────── -->
  <property>
    <name>fs.s3a.endpoint</name>
    <value>${env.LAKE_S3_ENDPOINT}</value>
  </property>
  <!-- Pin the signing region rather than let the AWS SDK guess it from a
       non-AWS endpoint; matches s3.region in catalogs/iceberg.properties
       and the region the warehouse bucket was created in. -->
  <property>
    <name>fs.s3a.endpoint.region</name>
    <value>us-east-1</value>
  </property>
  <property>
    <name>fs.s3a.access.key</name>
    <value>${env.LAKE_S3_ACCESS_KEY}</value>
  </property>
  <property>
    <name>fs.s3a.secret.key</name>
    <value>${env.LAKE_S3_SECRET_KEY}</value>
  </property>
  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>
  <property>
    <name>fs.s3a.connection.ssl.enabled</name>
    <value>false</value>
  </property>

  <!-- Trino's Iceberg connector opens one thrift connection per query;
       raise the server socket backlog so a burst of concurrent Superset
       queries doesn't get ECONNREFUSED. -->
  <property>
    <name>metastore.server.max.threads</name>
    <value>200</value>
  </property>
</configuration>
