{
  "_about": {
    "what": "What regions_report.py asserts, keyed by Postman item name. Keys starting with an underscore are ignored.",
    "shape": "{ \"<item name>\": { \"verdict\": \"PASS\"|null, \"http_status\": 400, \"criteria\": { \"<criterion>\": {\"verdict\": \"PASS\"|null, \"min_regions\": 1} } } }",
    "verdict_null": "A criterion with \"verdict\": null asserts NOTHING about the verdict. Every `llm` row is written that way on purpose: its score comes from a model, and a suite that claims to verify a model's judgement against a fixed answer is lying about what it measured.",
    "min_regions": "Asserted for the deterministic paths (cv / ocr / pdf-text / diff) where the fixtures' READMEs document a count. For `llm_boxes` rows it is 0 — 'you may produce boxes, and if you do they will be drawn' — so nothing false is claimed either way.",
    "http_status": "When present, the item is expected to be REJECTED at submit time and nothing else is asserted.",
    "sources": [
      "unit-tests/classifier/documents/README.md",
      "unit-tests/classifier/regions/README.md",
      "ai/classifier/API.md"
    ],
    "adding_a_case": "Add the Postman item, then an entry here. See unit-tests/classifier/REGIONS_REPORT.md."
  },

